{
  "widget": {
    "name": "widget.name",
    "description": "widget.description",
    "short_description": "widget.short_description",
    "version": "1.2.4",
    "interface_version": 2,
    "init_once": true,
    "locale": [
      "ru",
      "en"
    ],
    "installation": true,
    "support": {
      "link": "https://corsahelp.netlify.app",
      "email": "Corsa.integration@yandex.ru"
    }
  },
  "locations": [
    "widget_page",
    "settings"
  ],
  "left_menu": {
    "corsa_telegram_hub": {
      "title": "Corsa",
      "icons": {
        "light": "images/logo_small.png",
        "dark": "images/logo_small.png"
      },
      "sort": {
        "after": "leads"
      }
    }
  },
  "tour": {
    "is_tour": true,
    "tour_images": {
      "ru": [
        "images/logo_small.png",
        "images/logo.png",
        "images/logo_main.png"
      ],
      "en": [
        "images/logo_small.png",
        "images/logo.png",
        "images/logo_main.png"
      ]
    },
    "tour_description": "widget.tour_description"
  },
  "settings": {
    "login": {
      "name": "settings.login",
      "type": "users",
      "required": true
    }
  }
}