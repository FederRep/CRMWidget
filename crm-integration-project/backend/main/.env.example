NODE_ENV=production
PORT=3000
PROCESS_ROLE=all
# hybrid = Telegram Personal (MTProto) + очередь/webhook как у Wazzup
# bot_only = только Bot API (без личного аккаунта)
TELEGRAM_MODE=hybrid

# amoCRM OAuth (интеграция в аккаунте)
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=

JWT_SECRET=

# Telegram Bot API (QR через бота)
TELEGRAM_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Worker/queue tuning
QUEUE_PROVIDER=sqlite
REDIS_URL=
INBOUND_WORKER_POLL_MS=300
OUTBOUND_WORKER_POLL_MS=300
IDEMPOTENCY_TTL_HOURS=72
QUEUE_DLQ_ALERT_THRESHOLD=5
QUEUE_ALERT_INTERVAL_MS=60000

# Ops alerts (Slack/Telegram incoming webhook URL)
ALERT_WEBHOOK_URL=

# Telegram MTProto / «Связанные устройства» (my.telegram.org → API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# PostgreSQL (если используете отдельную БД на сервере)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
