{
  "name": "crmwidget",
  "version": "1.0.0",
  "description": "CRM Integration Widget - Telegram, VK, amoCRM",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd crm-integration-project/backend/main && node app.js",
    "dev:frontend": "cd crm-integration-project/frontend && npm run dev",
    "build": "cd crm-integration-project/frontend && npm run build",
    "start": "cd crm-integration-project/backend/main && NODE_ENV=production node app.js",
    "install:all": "npm install && cd crm-integration-project/frontend && npm install",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FederRep/CRMWidget.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/FederRep/CRMWidget/issues"
  },
  "homepage": "https://github.com/FederRep/CRMWidget#readme",
  "dependencies": {
    "axios": "^1.13.5",
    "axios-retry": "^4.5.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "concurrently": "^9.1.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "sqlite3": "^5.1.7",
    "telegram": "^2.26.22",
    "winston": "^3.19.0",
    "ws": "^8.19.0"
  }
}
